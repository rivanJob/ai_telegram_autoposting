APP_ENV=production
APP_DEBUG=0
APP_URL=https://example.com
ADMIN_DOMAIN=
ADMIN_PATH=/admin
APP_TIMEZONE=UTC
APP_SECRET=change_me_64_chars
SESSION_NAME=autoposter_session
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
SESSION_SECURE_COOKIE=1
ADMIN_IP_ALLOWLIST=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=autoposter
DB_USER=autoposter
DB_PASS=change_me

TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_DEFAULT_CHANNEL=@channel

GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_API_KEY=change_me
GROK_MODEL=grok-2-latest
GROK_TIMEOUT=45
GROK_JSON_REPAIR=0

WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=30
WORKER_STALE_RUNNING_MINUTES=30
QUIET_HOURS_START=
QUIET_HOURS_END=

WIREGUARD_MODE=off
WG_INTERFACE=wg0

LOG_LEVEL=info
LOG_PATH=/var/log/autoposter/app.log
