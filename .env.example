APP_ENV=production
APP_NAME=AutoPoster
APP_URL=https://example.com
APP_TIMEZONE=UTC
APP_DEBUG=0

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=autoposter
DB_USERNAME=autoposter
DB_PASSWORD=change_me

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_DEFAULT_CHANNEL=@channel

GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_API_KEY=replace_me
GROK_MODEL=grok-2-latest
GROK_TIMEOUT=45

SESSION_COOKIE=autoposter_session
SESSION_SECURE=1
SESSION_HTTPONLY=1
SESSION_SAMESITE=Strict
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
CSRF_TOKEN_TTL=7200
LOGIN_RATE_LIMIT_WINDOW=900
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_LOCKOUT_MAX_SECONDS=3600
ADMIN_IP_ALLOWLIST=

WORKER_MAX_ATTEMPTS=5
WORKER_BASE_BACKOFF_SECONDS=60
WORKER_DEAD_LETTER_MINUTES=30
QUIET_HOURS_START=
QUIET_HOURS_END=

WIREGUARD_MODE=off
WG_INTERFACE=wg0

LOG_LEVEL=info
LOG_FILE=/var/log/autoposter/app.log
