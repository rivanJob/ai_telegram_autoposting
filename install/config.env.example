# Copy to install/config.env and edit.
DOMAIN=example.com
ADMIN_DOMAIN=
ADMIN_PATH=/admin
TIMEZONE=UTC

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=autoposter
POSTGRES_USER=autoposter
POSTGRES_PASS=change_me

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHANNEL_ID=@channel
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_API_KEY=replace_me
GROK_MODEL=grok-2-latest

WIREGUARD_MODE=off
WG_INTERFACE=wg0

ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=change_me_now
ADMIN_IP_ALLOWLIST=

NGINX_ENABLE=1
CERTBOT_ENABLE=0
APP_DIR=/opt/autoposter
LOG_DIR=/var/log/autoposter
SETUP_DEMO_DATA=0
