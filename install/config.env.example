# Domains
DOMAIN=example.com
ADMIN_DOMAIN=
ADMIN_PATH=/admin
TIMEZONE=UTC

# Paths
APP_DIR=/opt/autoposter
LOG_DIR=/var/log/autoposter

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=autoposter
POSTGRES_USER=autoposter
POSTGRES_PASS=change_me

# Integrations
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_CHANNEL_ID=@example_channel
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_API_KEY=change_me
GROK_MODEL=grok-2-latest

# Security
ADMIN_BOOTSTRAP_USER=admin@example.com
ADMIN_BOOTSTRAP_PASS=change_me_strong
ADMIN_IP_ALLOWLIST=

# Network/WireGuard
WIREGUARD_MODE=off
WG_INTERFACE=wg0

# Platform toggles
NGINX_ENABLE=1
CERTBOT_ENABLE=0
SETUP_DEMO_DATA=0
